      "source": "import * as console from \"std/console\";\n\nclass Rect {\n  x: int = 0;\n  y: int = 0;\n  w: int = 0;\n  h: int = 0;\n}\n\nfunction checkAABB(a: Rect, b: Rect): boolean {\n  let overlapX: boolean = a.x < b.x + b.w && a.x + a.w > b.x;\n  let overlapY: boolean = a.y < b.y + b.h && a.y + a.h > b.y;\n  return overlapX && overlapY;\n}\n\nexport function main(): null {\n  let rectA: Rect = { x: 0, y: 0, w: 4, h: 4 };\n  let rectB: Rect = { x: 2, y: 2, w: 3, h: 3 };\n\n  let isColliding: boolean = checkAABB(rectA, rectB);\n\n  if (isColliding!== true) {\n    throw { code: \"CHECK_FAILED\", message: \"Rectangles should overlap\" };\n  }\n\n  let rectC: Rect = { x: 4, y: 4, w: 1, h: 1 };\n  let isTouching: boolean = checkAABB(rectA, rectC);\n\n  if (isTouching!== false) {\n    throw { code: \"CHECK_FAILED\", message: \"Touching edges should not count as overlap\" };\n  }\n\n  console.log(\"collision-aabb-1:ok\");\n  return null;\n}\n",
